<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- iOS si compila da macOS (o da Windows con un Mac associato). -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <!-- Solo controllo di compilazione del codice condiviso, senza SDK Android/iOS: dotnet build -p:TypeCheck=true -->
    <TargetFrameworks Condition="'$(TypeCheck)' == 'true'">net10.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0'">Library</OutputType>
    <RootNamespace>InquadraCasa.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <!-- In modalità TypeCheck si usano i soli pacchetti NuGet di MAUI, senza workload. -->
    <UseMaui Condition="'$(TypeCheck)' == 'true'">false</UseMaui>
    <EnableDefaultMauiItems Condition="'$(TypeCheck)' == 'true'">true</EnableDefaultMauiItems>
    <SingleProject>true</SingleProject>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>InquadraCasa</ApplicationTitle>
    <ApplicationId>it.inquadracasa.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1F4E79" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1F4E79" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
    <PackageReference Include="CommunityToolkit.Maui.Camera" Version="6.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InquadraCasa.Core\InquadraCasa.Core.csproj" />
  </ItemGroup>

</Project>
