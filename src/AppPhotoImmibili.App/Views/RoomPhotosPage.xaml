<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppPhotoImmibili.App.ViewModels"
             x:Class="AppPhotoImmibili.App.Views.RoomPhotosPage"
             x:DataType="vm:RoomPhotosViewModel"
             Title="{Binding Title}">
    <CollectionView ItemsSource="{Binding Items}" Margin="16,12" SelectionMode="None">
        <CollectionView.EmptyView>
            <Label Text="Nessuna foto per questo ambiente." Style="{StaticResource Muted}" HorizontalOptions="Center" Margin="24" />
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:PhotoItem">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Image Source="{Binding Image}" Aspect="AspectFit" HeightRequest="200" />
                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                        <Label Text="{Binding Badges}" Style="{StaticResource Muted}" />
                        <Label Text="{Binding FileName}" Style="{StaticResource Muted}" FontSize="11" LineBreakMode="MiddleTruncation" />
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="Condividi" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ShareCommand, Source={RelativeSource AncestorType={x:Type vm:RoomPhotosViewModel}}, x:DataType=vm:RoomPhotosViewModel}"
                                    CommandParameter="{Binding .}" />
                            <Button Text="Elimina" BackgroundColor="{StaticResource Bad}"
                                    Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type vm:RoomPhotosViewModel}}, x:DataType=vm:RoomPhotosViewModel}"
                                    CommandParameter="{Binding .}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
