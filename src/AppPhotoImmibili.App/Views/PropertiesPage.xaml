<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppPhotoImmibili.App.ViewModels"
             x:Class="AppPhotoImmibili.App.Views.PropertiesPage"
             x:DataType="vm:PropertiesViewModel"
             Title="Immobili">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ Nuovo" Command="{Binding NewCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto,Auto" Padding="16,12">
        <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                        <Label Text="Nessun immobile" Style="{StaticResource Title}" HorizontalOptions="Center" />
                        <Label Text="Crea la scheda dell'immobile: l'app ti guiderà ambiente per ambiente con gli scatti necessari."
                               Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PropertyItem">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Elimina" BackgroundColor="{StaticResource Bad}"
                                               Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type vm:PropertiesViewModel}}, x:DataType=vm:PropertiesViewModel}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Style="{StaticResource Card}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:PropertiesViewModel}}, x:DataType=vm:PropertiesViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Title}" Style="{StaticResource Title}" />
                                    <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
                                    <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource Ok}" Margin="0,6,0,0" />
                                    <Label Text="{Binding ProgressText}" Style="{StaticResource Muted}" />
                                </VerticalStackLayout>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <Label Grid.Row="1" Text="{Binding SyncText}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center"
               IsVisible="{Binding SyncText, Converter={StaticResource IsNotEmpty}}" />
        <Button Grid.Row="2" Text="Nuovo immobile" Command="{Binding NewCommand}" Margin="0,8,0,0" />
    </Grid>
</ContentPage>
