<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppPhotoImmibili.App.ViewModels"
             x:Class="AppPhotoImmibili.App.Views.ChecklistPage"
             x:DataType="vm:ChecklistViewModel"
             Title="{Binding Property.Code}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Esporta" Command="{Binding ExportCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto" Padding="16,12" RowSpacing="8">
        <Border Style="{StaticResource Card}" Margin="0">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Property.DisplayName}" Style="{StaticResource Title}" />
                <ProgressBar Progress="{Binding ProgressValue}" ProgressColor="{StaticResource Ok}" />
                <Label Text="{Binding Summary}" Style="{StaticResource Muted}" />
                <Label Text="{Binding NextStepText}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Rooms}" SelectionMode="None">
            <CollectionView.Header>
                <Border Style="{StaticResource Card}" BackgroundColor="#FFF7E8">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Prima di iniziare" FontAttributes="Bold" TextColor="#8A5A00" />
                        <Label Text="{Binding GeneralTips}" FontSize="13" TextColor="#8A5A00" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:RoomItem">
                    <Border Style="{StaticResource Card}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding RoomActionsCommand, Source={RelativeSource AncestorType={x:Type vm:ChecklistViewModel}}, x:DataType=vm:ChecklistViewModel}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding StatusIcon}" TextColor="{Binding StatusColor}" FontSize="26" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding ShotsText}" Style="{StaticResource Muted}" />
                                <Label Text="{Binding DetailsText}" Style="{StaticResource Muted}" FontAttributes="Italic"
                                       IsVisible="{Binding HasDetails}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="📷" FontSize="18" Padding="12,6" VerticalOptions="Center"
                                    Command="{Binding RoomActionsCommand, Source={RelativeSource AncestorType={x:Type vm:ChecklistViewModel}}, x:DataType=vm:ChecklistViewModel}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <Button Text="+ Aggiungi ambiente" Style="{StaticResource SecondaryButton}" Command="{Binding AddRoomCommand}" Margin="0,4,0,12" />
            </CollectionView.Footer>
        </CollectionView>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button Text="Continua il percorso" Command="{Binding ContinueCommand}" />
            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </Grid>
    </Grid>
</ContentPage>
